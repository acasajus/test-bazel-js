bazel_dep(name = "aspect_rules_js", version = "3.0.3")
bazel_dep(name = "aspect_rules_ts", version = "3.8.8")
bazel_dep(name = "aspect_rules_swc", version = "2.7.1")
bazel_dep(name = "aspect_gazelle_prebuilt", version = "0.0.6")
bazel_dep(name = "gazelle", version = "0.50.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")

# Node.js toolchain
node = use_extension("@aspect_rules_js//npm:extensions.bzl", "node", dev_dependency = True)
node.toolchain(node_version = "20.11.0")
use_repo(node, "node_toolchains")

# NPM dependencies translation
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", dev_dependency = True)
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//frontend:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

# TS configuration
rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext", dev_dependency = True)
rules_ts_ext.deps(
    ts_version_from = "//frontend:package.json",
)
use_repo(rules_ts_ext, "npm_typescript")
